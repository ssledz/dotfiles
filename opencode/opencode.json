{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-opus-4.6",
  "small_model": "github-copilot/gpt-4o-mini",
  "autoupdate": true,
  "share": "manual",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "instructions": [],
  "plugin": [
    "oh-my-openagent@latest",
    "./plugins/caveman/plugin.js"
  ],
  "mcp": {
    "jira-mcp": {
      "type": "local",
      "enabled": false,
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "JIRA_URL",
        "-e",
        "JIRA_USERNAME",
        "-e",
        "JIRA_API_TOKEN",
        "ghcr.io/sooperset/mcp-atlassian:latest"
      ],
      "environment": {
        "JIRA_URL": "{env:JIRA_URL}",
        "JIRA_USERNAME": "{env:JIRA_USERNAME}",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
      }
    },
    "github-mcp": {
      "type": "local",
      "enabled": false,
      "command": [
        "docker",
        "run",
        "--rm",
        "-i",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server:latest"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_OPENCODE_PAT}"
      }
    }
  },
  "lsp": {
    "purescript": {
      "command": [
        "npx",
        "purescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".purs"
      ],
      "initialization": {
        "purescript": {
          "formatter": "purs-tidy",
          "addPscPackageSources": true,
          "addNpmPath": true
        }
      }
    },
    "metals": {
      "command": [
        "/Users/slawomir.sledz/bin/metals"
      ],
      "extensions": [
        ".scala",
        ".sbt",
        ".sc"
      ],
      "env": {
        "JAVA_HOME": "/Users/slawomir.sledz/.jenv/versions/17"
      },
      "initialization": {
        "compilerOptions": {
          "isCompletionItemDetailEnabled": true,
          "isCompletionItemDocumentationEnabled": true,
          "isHoverDocumentationEnabled": true,
          "isSignatureHelpDocumentationEnabled": true
        },
        "doctorProvider": "json",
        "statusBarProvider": "log-message"
      }
    }
  }
}
