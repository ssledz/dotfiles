{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "lmstudio": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "LM Studio (local)",
            "options": {
                "baseURL": "http://127.0.0.1:1234/v1"
            },
            "models": {
                "google/gemma-3n-e4b": {
                    "name": "Gemma 3n-e4b (local)"
                },
                "qwen3-coder-30b-a3b-instruct-mlx": {
                    "name": "Qwen3-Coder 30b-a3b-mlx"
                },
                "qwen2.5-coder-7b-instruct-mlx": {
                    "name": "Qwen2.5-Coder 7b-mlx"
                }


            }
        }
    },
    "model": "lmstudio/qwen3-coder-30b-a3b-instruct-mlx",
    "small_model": "lmstudio/qwen2.5-coder-7b-instruct-mlx",
    "username": "ssledz",
    "autoupdate": true,
    "permission": {
        "lsp": "allow"
    },
    "plugin": [
    "@franlol/opencode-md-table-formatter@latest",
    "opencode-devcontainers",
    "oh-my-openagent@latest"
  ],
    "lsp": {
        "purescript": {
            "command": ["npx", "purescript-language-server", "--stdio"],
            "extensions": [".purs"],
            "initialization": {
                "purescript": {
                    "formatter": "purs-tidy",
                    "addPscPackageSources": true,
                    "addNpmPath": true
                }
            }
        },
        "metals": {
            "command": [
                "/Users/ssledz/bin/metals"
            ],
            "extensions": [
                ".scala",
                ".sbt",
                ".sc"
            ],
            "env": {
                "JAVA_HOME": "/Users/ssledz/.sdkman/candidates/java/current"
            },
            "initialization": {
                "compilerOptions": {
                    "isCompletionItemDetailEnabled": true,
                    "isCompletionItemDocumentationEnabled": true,
                    "isHoverDocumentationEnabled": true,
                    "isSignatureHelpDocumentationEnabled": true
                },
                "doctorProvider": "json",
                "statusBarProvider": "log-message"
            }
        }
    },
    "mcp": {
        "jira-mcp": {
            "type": "local",
            "enabled": false,
            "command": [
                "docker",
                "run",
                "-i",
                "--rm",
                "-e",
                "JIRA_URL",
                "-e",
                "JIRA_USERNAME",
                "-e",
                "JIRA_API_TOKEN",
                "ghcr.io/sooperset/mcp-atlassian:latest"
            ],
            "environment": {
                "JIRA_URL": "{env:JIRA_URL}",
                "JIRA_USERNAME": "{env:JIRA_USERNAME}",
                "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
            }
        }
    }
}
